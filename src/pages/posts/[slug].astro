---
import { render } from 'astro:content';
import Base from '../../layouts/BaseLayout.astro';
import { getPosts } from '../../lib/posts';
import { SITE } from '../../config';
import { absUrl, withBase, slugify, fmtDate, readingMinutes, wordCount } from '../../lib/util';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: {
      post,
      related: posts
        .filter((p) => p.slug !== post.slug && p.data.category === post.data.category)
        .slice(0, 4)
        .map((p) => ({ slug: p.slug, title: p.data.title })),
    },
  }));
}

const { post, related } = Astro.props;
const { Content } = await render(post);
const { title, description, date, category, tags } = post.data;
const path = `/posts/${post.slug}/`;
const url = absUrl(path, Astro.site);
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: title,
    description,
    datePublished: date.toISOString(),
    dateModified: date.toISOString(),
    author: { '@type': 'Organization', name: SITE.author, url: absUrl('/about/', Astro.site) },
    publisher: { '@type': 'Organization', name: SITE.name, url: absUrl('/', Astro.site) },
    mainEntityOfPage: { '@type': 'WebPage', '@id': url },
    articleSection: category,
    keywords: tags.join(', '),
    wordCount: wordCount(post.body),
    inLanguage: SITE.lang,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: absUrl('/', Astro.site) },
      { '@type': 'ListItem', position: 2, name: category, item: absUrl(`/category/${slugify(category)}/`, Astro.site) },
      { '@type': 'ListItem', position: 3, name: title, item: url },
    ],
  },
];
---
<Base
  title={title}
  description={description}
  path={path}
  type="article"
  published={date}
  section={category}
  tags={tags}
  jsonLd={jsonLd}
  markdownPath={`/posts/${post.slug}.md`}
>
  <article>
    <header>
      <h1>{title}</h1>
      <div class="meta">
        <time datetime={date.toISOString()}>{fmtDate(date)}</time>
        · <a href={withBase(`/category/${slugify(category)}/`)}>{category}</a>
        · {readingMinutes(post.body)} min read
      </div>
    </header>
    <div class="prose">
      <Content />
    </div>
    {post.data.ai_assisted && (
      <p class="notice">
        This article was written with AI assistance and published automatically. Test commands on a
        non-production system first. See our <a href={withBase('/editorial-policy/')}>editorial policy</a>.
      </p>
    )}
  </article>
  {related.length > 0 && (
    <aside class="related" aria-label="Related articles">
      <h2>More in {category}</h2>
      <ul>
        {related.map((r) => <li><a href={withBase(`/posts/${r.slug}/`)}>{r.title}</a></li>)}
      </ul>
    </aside>
  )}
</Base>

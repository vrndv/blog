---
import { render } from 'astro:content';
import Base from '../../layouts/BaseLayout.astro';
import Cover from '../../components/Cover.astro';
import AdSlot from '../../components/AdSlot.astro';
import { getPosts } from '../../lib/posts';
import { SITE } from '../../config';
import { absUrl, withBase, slugify, fmtDate, readingMinutes, wordCount, hostOf } from '../../lib/util';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: {
      post,
      related: posts
        .filter((p) => p.slug !== post.slug && p.data.category === post.data.category)
        .slice(0, 4)
        .map((p) => ({ slug: p.slug, title: p.data.title })),
    },
  }));
}

const { post, related } = Astro.props;
const { Content } = await render(post);
const d = post.data;
const path = `/posts/${post.slug}/`;
const url = absUrl(path, Astro.site);
const sourceLabel = d.source_name || hostOf(d.source_url);
const blogPosting: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: d.title,
  description: d.description,
  datePublished: d.date.toISOString(),
  dateModified: d.date.toISOString(),
  author: { '@type': 'Organization', name: SITE.author, url: absUrl('/about/', Astro.site) },
  publisher: { '@type': 'Organization', name: SITE.name, url: absUrl('/', Astro.site) },
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  articleSection: d.category,
  keywords: d.tags.join(', '),
  wordCount: wordCount(post.body),
  inLanguage: SITE.lang,
};
if (d.image) blogPosting.image = [d.image];
if (d.source_url) blogPosting.isBasedOn = d.source_url;
const jsonLd = [
  blogPosting,
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: absUrl('/', Astro.site) },
      { '@type': 'ListItem', position: 2, name: d.category, item: absUrl(`/category/${slugify(d.category)}/`, Astro.site) },
      { '@type': 'ListItem', position: 3, name: d.title, item: url },
    ],
  },
];
---
<Base
  title={d.title}
  description={d.description}
  path={path}
  type="article"
  published={d.date}
  section={d.category}
  tags={d.tags}
  jsonLd={jsonLd}
  markdownPath={`/posts/${post.slug}.md`}
  image={d.image}
>
  <article>
    <header>
      <div class="kicker"><a href={withBase(`/category/${slugify(d.category)}/`)}>{d.category}</a></div>
      <h1>{d.title}</h1>
      <div class="meta">
        <time datetime={d.date.toISOString()}>{fmtDate(d.date)}</time> · {readingMinutes(post.body)} min read
      </div>
      <figure class="hero-img">
        <Cover post={post} eager />
        {d.image && d.image_credit && (
          <figcaption class="meta">
            Photo by <a href={d.image_credit_url} rel="noopener">{d.image_credit}</a> on <a href="https://www.pexels.com" rel="noopener">Pexels</a>
          </figcaption>
        )}
      </figure>
    </header>
    <AdSlot slot="top" />
    <div class="prose">
      <Content />
    </div>
    {d.source_url && (
      <aside class="source">
        Based on reporting from <a href={d.source_url} rel="noopener" target="_blank">{sourceLabel}</a>.
        This article is our own summary and analysis. Read the original for full details.
      </aside>
    )}
    <AdSlot slot="bottom" />
  </article>
  {related.length > 0 && (
    <aside class="related" aria-label="Related articles">
      <h2>More in {d.category}</h2>
      <ul>
        {related.map((r) => <li><a href={withBase(`/posts/${r.slug}/`)}>{r.title}</a></li>)}
      </ul>
    </aside>
  )}
</Base>
